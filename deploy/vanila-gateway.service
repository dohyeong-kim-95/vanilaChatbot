[Unit]
Description=vanilaChatbot LLM gateway (OpenAI-compatible, Anthropic API behind it)
After=network-online.target
Wants=network-online.target

[Service]
User=vanila
Group=vanila
EnvironmentFile=/etc/vanila/gateway.env
WorkingDirectory=/opt/vanila/current
ExecStart=/opt/vanila/current/.venv/bin/uvicorn gateway.app:app --timeout-graceful-shutdown 60 --host 127.0.0.1 --port 8100
Restart=on-failure
# a model call in progress is let finish (a cut one makes the client retry, paying twice, or fails the run)
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# never needs Docker: no docker group here (only the app's unit has it), and the socket hidden as well
InaccessiblePaths=-/run/docker.sock

[Install]
WantedBy=multi-user.target
