[Unit]
Description=vanilaChatbot artifact renderer
After=network-online.target

[Service]
User=vanila
Group=vanila
EnvironmentFile=/etc/vanila/vanila.env
WorkingDirectory=/opt/vanila/current
ExecStart=/opt/vanila/current/.venv/bin/uvicorn server.render:app --timeout-graceful-shutdown 5 --host 127.0.0.1 --port 8201
Restart=on-failure
# open event streams do not end by themselves: without a limit a restart waits for them (90 s, then SIGKILL)
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# never needs Docker: no docker group here (only the app's unit has it), and the socket hidden as well
InaccessiblePaths=-/run/docker.sock
ReadOnlyPaths=/var/lib/vanila

[Install]
WantedBy=multi-user.target
