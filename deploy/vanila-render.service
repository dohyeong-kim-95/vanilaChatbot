[Unit]
Description=vanilaChatbot artifact renderer
After=network-online.target

[Service]
User=vanila
Group=vanila
EnvironmentFile=/etc/vanila/vanila.env
WorkingDirectory=/opt/vanila/current
ExecStart=/opt/vanila/current/.venv/bin/uvicorn server.render:app --host 127.0.0.1 --port 8201
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/vanila

[Install]
WantedBy=multi-user.target
